# =============================================================================
# AiTrainer 环境变量配置
# 复制此文件为 .env 并填入实际值
# =============================================================================

# ------------------------- 数据库配置 -------------------------
MYSQL_ROOT_PASSWORD=AiTrainer@2024
MYSQL_DB=ai_trainer
MYSQL_USER=aitrainer
MYSQL_PASSWORD=AiTrainer@2024
MYSQL_PORT=3306

# ------------------------- Redis 配置 -------------------------
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# ------------------------- 服务端口 -------------------------
BACKEND_PORT=3000
FRONTEND_PORT=80

# ------------------------- 邮件配置 -------------------------
# QQ邮箱示例
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your授权码

# ------------------------- 阿里云 OSS 配置 -------------------------
ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_BUCKET=your-bucket-name
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret

# ------------------------- AI 模型配置 -------------------------
AI_API_KEY=your-openai-api-key
AI_MODEL=gpt-5.4
AI_BASE_URL=https://api.openai.com/v1/
# AI_BASE_URL=https://ai.sandboxai.top/v1/  # 国内代理示例

# ------------------------- JWT 配置 -------------------------
# 必须至少64字符长（HS512算法要求），生产环境请务必修改为随机字符串
JWT_SECRET=please_change_this_to_a_random_string_at_least_64_characters_long_for_security
