-- AiTrainer Database Initialization Script (v3.0)
-- Matches DB_DESIGN.md v3.0

SET NAMES utf8mb4;
SET FOREIGN_KEY_CHECKS = 0;

-- ----------------------------
-- 1. Users & Profiles
-- ----------------------------

-- Table: users
CREATE TABLE IF NOT EXISTS `users` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `username` VARCHAR(50) NOT NULL UNIQUE COMMENT '登录用户名',
    `email` VARCHAR(100) NOT NULL UNIQUE COMMENT '邮箱地址',
    `password_hash` VARCHAR(255) NOT NULL COMMENT '加密密码哈希',
    `avatar` VARCHAR(255) COMMENT '头像URL',
    `is_pro` BOOLEAN DEFAULT FALSE COMMENT '是否PRO会员',
    `is_first_login` BOOLEAN DEFAULT TRUE COMMENT '首次登录标记',
    `following_count` INT DEFAULT 0 COMMENT '关注数量',
    `follower_count` INT DEFAULT 0 COMMENT '粉丝数量',
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    `updated_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    `deleted_at` TIMESTAMP NULL DEFAULT NULL,
    INDEX `idx_username` (`username`),
    INDEX `idx_email` (`email`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
-- 1. 添加状态字段（用于你刚才说的注销功能）
ALTER TABLE `users` ADD COLUMN `status` TINYINT DEFAULT 0 COMMENT '状态：0-正常, -1-已注销';

-- 2. 顺便把 token_version 也补上（我看你报错的 SQL 里也查了这个字段）
-- 这个通常用于实现“一处注销，全端失效”
ALTER TABLE `users` ADD COLUMN `token_version` INT DEFAULT 0 COMMENT '令牌版本号';

-- Table: user_profiles
CREATE TABLE IF NOT EXISTS `user_profiles` (
    `user_id` INT PRIMARY KEY COMMENT '关联用户ID',
    `gender` ENUM('male', 'female', 'other') NOT NULL COMMENT '性别',
    `height` DECIMAL(5, 2) NOT NULL COMMENT '身高(cm)',
    `weight` DECIMAL(5, 2) NOT NULL COMMENT '体重(kg)',
    `body_fat` DECIMAL(4, 2) COMMENT '体脂率(%)',
    `goal` ENUM('lose', 'gain', 'maintain') NOT NULL COMMENT '健身目标',
    `bio` TEXT COMMENT '个人简介',
    `updated_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (`user_id`) REFERENCES `users`(`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
ALTER TABLE user_profiles ADD COLUMN total_likes INT UNSIGNED DEFAULT 0;
ALTER TABLE user_profiles ADD COLUMN age INT DEFAULT NULL COMMENT '用户年龄';
ALTER TABLE user_profiles ADD COLUMN nickname VARCHAR(50) DEFAULT NULL COMMENT '用户昵称';
-- ----------------------------
-- 2. Social & Tracking
-- ----------------------------

-- Table: user_follows
CREATE TABLE IF NOT EXISTS `user_follows` (
    -- 1. 独立自增主键，计科标准做法
    `id` BIGINT AUTO_INCREMENT PRIMARY KEY COMMENT '自增主键',
    
    `follower_id` INT NOT NULL COMMENT '关注者ID',
    `followed_id` INT NOT NULL COMMENT '被关注者ID',
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP COMMENT '关注时间',

    -- 2. 联合唯一索引：核心逻辑，防止 A 重复关注 B
    UNIQUE INDEX `uk_follower_followed` (`follower_id`, `followed_id`),

    -- 3. 外键约束：保证数据的引用完整性
    FOREIGN KEY (`follower_id`) REFERENCES `users`(`id`) ON DELETE CASCADE,
    FOREIGN KEY (`followed_id`) REFERENCES `users`(`id`) ON DELETE CASCADE,

    -- 4. 辅助索引：优化查询“我的粉丝”列表的速度
    -- 注意：follower_id 已经在唯一索引的第一列了，所以不需要单独再建 idx_follower
    INDEX `idx_followed` (`followed_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='用户关注关系表';

-- ----------------------------
-- 3. Collections
-- ----------------------------

-- Table: collection_folder

CREATE TABLE `collection_folder` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键ID',
  `user_id` bigint NOT NULL COMMENT '所属用户ID',
  `name` varchar(100) NOT NULL COMMENT '收藏夹名称',
  `is_public` tinyint DEFAULT '0' COMMENT '是否公开：0-私密，1-公开',
  `is_default` tinyint DEFAULT '0' COMMENT '是否为默认收藏夹：0-普通，1-默认',
  `create_time` datetime DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `update_time` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  `is_deleted` tinyint DEFAULT '0' COMMENT '逻辑删除：0-未删除，1-已删除',
  PRIMARY KEY (`id`),
  KEY `idx_user_id` (`user_id`) -- 为用户ID建索引，方便查询某个人的所有收藏夹
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='收藏夹表';

CREATE TABLE `collection_item` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键ID',
  `folder_id` bigint NOT NULL COMMENT '收藏夹ID',
  `post_id` bigint NOT NULL COMMENT '被收藏的推文ID',
  `user_id` bigint NOT NULL COMMENT '所属用户ID（冗余字段，方便直接查询用户的所有收藏）',
  `create_time` datetime DEFAULT CURRENT_TIMESTAMP COMMENT '收藏时间',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_folder_post` (`folder_id`, `post_id`), -- ✅ 关键：唯一联合索引，防止同一个推文在同一个文件夹里存两遍
  KEY `idx_user_post` (`user_id`, `post_id`),         -- 方便快速查询：该用户是否收藏过该推文
  KEY `idx_folder_id` (`folder_id`)                   -- 方便查询收藏夹下的所有内容
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='收藏明细表';
ALTER TABLE collection_item ADD COLUMN is_deleted TINYINT DEFAULT 0;
-- ----------------------------
-- 4. Workouts & Sessions
-- ----------------------------

-- Table: workouts
CREATE TABLE IF NOT EXISTS `workouts` (
    `id` VARCHAR(50) PRIMARY KEY COMMENT '项目标识',
    `name` VARCHAR(100) NOT NULL COMMENT '中文名称',
    `en_name` VARCHAR(100) NOT NULL COMMENT '英文名称',
    `difficulty` INT DEFAULT 1 COMMENT '推荐难度',
    `tags` JSON COMMENT '项目标签',
    `description` TEXT COMMENT '描述',
    `theme_color` VARCHAR(20) DEFAULT '#409EFF' COMMENT '主题色',
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    `deleted_at` TIMESTAMP NULL DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- Table: workout_sessions
CREATE TABLE IF NOT EXISTS `workout_sessions` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `user_id` INT NOT NULL COMMENT '用户ID',
    `workout_id` VARCHAR(50) NOT NULL COMMENT '项目ID',
    `score` INT NOT NULL COMMENT '综合评分',
    `grade` VARCHAR(5) NOT NULL COMMENT '评级',
    `grade_level` VARCHAR(20) COMMENT '评级样式类',
    `comment` TEXT COMMENT 'AI点评',
    `valid_reps` INT DEFAULT 0 COMMENT '有效次数',
    `invalid_reps` INT DEFAULT 0 COMMENT '异常次数',
    `duration_seconds` INT DEFAULT 0 COMMENT '训练时长(秒)',
    `calories_burned` INT DEFAULT 0 COMMENT '消耗热量',
    `radar_scores` JSON COMMENT '五维评分',
    `snapshots` JSON COMMENT '纠错抓拍',
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (`user_id`) REFERENCES `users`(`id`) ON DELETE CASCADE,
    FOREIGN KEY (`workout_id`) REFERENCES `workouts`(`id`),
    INDEX `idx_user_workouts` (`user_id`, `created_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
ALTER TABLE workout_sessions ADD COLUMN is_deleted TINYINT DEFAULT 0;
ALTER TABLE workout_sessions 
ADD COLUMN like_count INT DEFAULT 0 COMMENT '获赞总数' AFTER calories_burned;

CREATE TABLE `workout_session_likes` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `session_id` bigint NOT NULL COMMENT '战报ID',
  `user_id` bigint NOT NULL COMMENT '点赞用户ID',
  `created_at` datetime DEFAULT CURRENT_TIMESTAMP COMMENT '点赞时间',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_session_user` (`session_id`,`user_id`) COMMENT '唯一索引，防止重复点赞'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='战报点赞关联表';
-- ----------------------------
-- 5. Community Interactions
-- ----------------------------

-- Table: community_posts
CREATE TABLE IF NOT EXISTS `community_posts` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `user_id` INT NOT NULL COMMENT '发布者ID',
    `content` TEXT NOT NULL COMMENT '内容',
    `topic` VARCHAR(50) COMMENT '话题',
    `device` VARCHAR(50) DEFAULT 'AiTrainer App' COMMENT '发布设备',
    `ai_report_id` INT NULL COMMENT '关联战报ID',
    
    -- ================= 新增：冗余计数字段 =================
    `like_count` INT UNSIGNED DEFAULT 0 COMMENT '点赞总数',
    `favorite_count` INT UNSIGNED DEFAULT 0 COMMENT '收藏总数',
    `comment_count` INT UNSIGNED DEFAULT 0 COMMENT '评论总数',
    -- ====================================================

    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    `updated_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    `deleted_at` TIMESTAMP NULL DEFAULT NULL,
    
    -- 外键约束
    FOREIGN KEY (`user_id`) REFERENCES `users`(`id`) ON DELETE CASCADE,
    FOREIGN KEY (`ai_report_id`) REFERENCES `workout_sessions`(`id`) ON DELETE SET NULL,
    
    -- 索引优化
    INDEX `idx_user_posts` (`user_id`, `created_at`), -- 优化个人主页时间轴查询
    INDEX `idx_topic_created` (`topic`, `created_at`), -- 优化话题页搜索排布
    INDEX `idx_created_at` (`created_at`) -- 优化全站最新动态流分页
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
ALTER TABLE community_posts ADD COLUMN is_deleted TINYINT DEFAULT 0;

-- Table: post_images
CREATE TABLE IF NOT EXISTS `post_images` (
    `id` BIGINT AUTO_INCREMENT PRIMARY KEY,
    `post_id` INT NOT NULL COMMENT '关联动态ID',
    `object_key` VARCHAR(255) NOT NULL COMMENT 'OSS 对象 Key',
    `sort_order` INT DEFAULT 0 COMMENT '排序',
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (`post_id`) REFERENCES `community_posts`(`id`) ON DELETE CASCADE,
    INDEX `idx_post_images` (`post_id`, `sort_order`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- Table: post_likes
CREATE TABLE IF NOT EXISTS `post_likes` (
    `post_id` INT NOT NULL COMMENT '动态ID',
    `user_id` INT NOT NULL COMMENT '用户ID',
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (`post_id`, `user_id`),
    FOREIGN KEY (`post_id`) REFERENCES `community_posts`(`id`) ON DELETE CASCADE,
    FOREIGN KEY (`user_id`) REFERENCES `users`(`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- Table: post_favorites
CREATE TABLE IF NOT EXISTS `post_favorites` (
    `post_id` INT NOT NULL COMMENT '动态ID',
    `user_id` INT NOT NULL COMMENT '用户ID',
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (`post_id`, `user_id`),
    FOREIGN KEY (`post_id`) REFERENCES `community_posts`(`id`) ON DELETE CASCADE,
    FOREIGN KEY (`user_id`) REFERENCES `users`(`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- Table: post_comments
CREATE TABLE IF NOT EXISTS `post_comments` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `post_id` INT NOT NULL COMMENT '动态ID',
    `user_id` INT NOT NULL COMMENT '用户ID',
    `parent_id` INT DEFAULT NULL COMMENT '父级评论ID',
    `content` TEXT NOT NULL COMMENT '内容',
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    `deleted_at` TIMESTAMP NULL DEFAULT NULL,
    FOREIGN KEY (`post_id`) REFERENCES `community_posts`(`id`) ON DELETE CASCADE,
    FOREIGN KEY (`user_id`) REFERENCES `users`(`id`) ON DELETE CASCADE,
    FOREIGN KEY (`parent_id`) REFERENCES `post_comments`(`id`) ON DELETE CASCADE,
    INDEX `idx_post_comments` (`post_id`, `created_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
ALTER TABLE post_comments ADD COLUMN is_deleted TINYINT DEFAULT 0;
-- ----------------------------
-- 6. Diet Management
-- ----------------------------

-- Table: meals
CREATE TABLE IF NOT EXISTS `meals` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `user_id` INT NOT NULL COMMENT '用户ID',
    `meal_time` DATETIME NOT NULL COMMENT '进餐时间',
    `meal_type` ENUM('breakfast', 'lunch', 'dinner', 'snack') NOT NULL COMMENT '餐次类型',
    `food_name` TEXT NOT NULL COMMENT '食物名称',
    `calories` INT DEFAULT 0 COMMENT '热量(kcal)',
    `protein` INT DEFAULT 0 COMMENT '蛋白质(g)',
    `fat` INT DEFAULT 0 COMMENT '脂肪(g)',
    `carbs` INT DEFAULT 0 COMMENT '碳水化合物(g)',
    `tag_type` VARCHAR(20) DEFAULT 'info' COMMENT '标签样式',
    `weight` INT DEFAULT 0 COMMENT '食物重量(g)',
    `is_deleted` TINYINT DEFAULT 0 COMMENT '逻辑删除(0:正常,1:已删除)',
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (`user_id`) REFERENCES `users`(`id`) ON DELETE CASCADE,
    INDEX `idx_user_meals` (`user_id`, `meal_time`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

