-- ----------------------------
-- 7. Extra Exercise (用户自行添加的项目外运动消耗)
-- ----------------------------
CREATE TABLE IF NOT EXISTS `extra_exercises` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `user_id` INT NOT NULL COMMENT '用户ID',
    `exercise_name` VARCHAR(100) NOT NULL COMMENT '运动名称',
    `description` VARCHAR(500) DEFAULT NULL COMMENT '运动描述(如配速、距离等)',
    `calories_burned` INT DEFAULT 0 COMMENT '消耗热量(kcal)',
    `duration_minutes` INT DEFAULT 0 COMMENT '运动时长(分钟)',
    `exercise_date` DATE NOT NULL COMMENT '运动日期',
    `is_deleted` TINYINT DEFAULT 0 COMMENT '逻辑删除(0:正常,1:已删除)',
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (`user_id`) REFERENCES `users`(`id`) ON DELETE CASCADE,
    INDEX `idx_user_exercise_date` (`user_id`, `exercise_date`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='用户额外运动消耗记录';

-- 为已有表添加 description 字段
ALTER TABLE `extra_exercises` ADD COLUMN IF NOT EXISTS `description` VARCHAR(500) DEFAULT NULL COMMENT '运动描述(如配速、距离等)' AFTER `exercise_name`;

SET FOREIGN_KEY_CHECKS = 1;

CREATE TABLE `community_guestbook` (
  `id` bigint(20) NOT NULL AUTO_INCREMENT COMMENT '主键ID',
  `from_user_id` bigint(20) NOT NULL COMMENT '留言者ID',
  `to_user_id` bigint(20) NOT NULL COMMENT '被留言者（空间主人）ID',
  `content` varchar(500) NOT NULL COMMENT '留言内容',
  `create_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '留言时间',

  -- 回复部分：直接冗余在表中，实现“只能回复一次”
  `reply_content` varchar(500) DEFAULT NULL COMMENT '主人回复内容',
  `reply_time` datetime DEFAULT NULL COMMENT '回复时间',

  -- 逻辑删除与审计
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '逻辑删除 (0:未删, 1:已删)',
  `update_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',

  PRIMARY KEY (`id`),
  KEY `idx_to_user` (`to_user_id`), -- 空间访问频率高，给宿主加索引
  KEY `idx_from_user` (`from_user_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='用户空间留言板';


CREATE TABLE `user_privacy_settings` (
  `user_id` bigint(20) NOT NULL COMMENT '用户ID',
  `public_ai_report` tinyint(1) NOT NULL DEFAULT '1' COMMENT '是否公开展示AI战报 (1:公开, 0:私密)',
  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`user_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='用户隐私设置表';

-- AI 教练聊天历史表
-- 用于存储用户与 AI 教练的对话记录，实现上下文功能

CREATE TABLE IF NOT EXISTS `ai_coach_chat_history` (
    `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '主键 ID',
    `user_id` BIGINT NOT NULL COMMENT '用户 ID',
    `session_id` VARCHAR(100) NOT NULL COMMENT '会话 ID',
    `role` VARCHAR(20) NOT NULL COMMENT '消息角色：user-用户消息, assistant-AI回复',
    `content` TEXT NOT NULL COMMENT '消息内容',
    `analysis_type` VARCHAR(50) DEFAULT NULL COMMENT '分析类型：training-训练分析, diet-饮食分析, comprehensive-综合分析, chat-闲聊',
    `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    PRIMARY KEY (`id`),
    INDEX `idx_user_session` (`user_id`, `session_id`),
    INDEX `idx_user_id` (`user_id`),
    INDEX `idx_session_id` (`session_id`),
    INDEX `idx_created_at` (`created_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='AI 教练聊天历史表';
-- 添加 reply_to 列到 ai_coach_chat_history 表
-- 用于建立问答之间的显式血缘关系，避免"猜"主人

ALTER TABLE ai_coach_chat_history
ADD COLUMN reply_to BIGINT DEFAULT NULL COMMENT '关联提问的消息 ID';

-- 创建索引以提高查询性能
CREATE INDEX idx_reply_to ON ai_coach_chat_history(reply_to);